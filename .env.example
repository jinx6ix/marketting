# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret the cron triggers (pg_cron / dev worker) send as Bearer token
CRON_SECRET=
# 32-byte base64 key for AES-256-GCM encryption of social tokens at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (provider-agnostic, free-tier models) ─────────────────────────
# Primary provider: nim | groq | openrouter
AI_PROVIDER=nim
AI_MODEL=meta/llama-3.3-70b-instruct
# Comma-separated fallback chain, tried in order on 429/5xx
AI_FALLBACK_PROVIDERS=groq,openrouter
NIM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Meta (Facebook Pages + Instagram share one app) ──────────────────
META_APP_ID=
META_APP_SECRET=

# ── X (Twitter) ──────────────────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
# free = write-only publishing; basic (paid) unlocks mentions/search/metrics
X_TIER=free

# ── TikTok ───────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited TikTok apps can only post as private/self-view
TIKTOK_AUDITED=false

# ── YouTube / Google ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key for public data (competitor channels) without OAuth
YOUTUBE_API_KEY=

# ── LinkedIn ─────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Pinterest ────────────────────────────────────────────────────────
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ── Dev ──────────────────────────────────────────────────────────────
# 1 = use the mock adapter for all platforms (build/demo without credentials)
SOCIAL_MOCK=0
